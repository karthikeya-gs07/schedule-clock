<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application android:label="@string/app_name">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Calendar access (READ_CALENDAR): opened by a ring tap while it's missing, or from the app list. -->
        <activity
            android:name=".PermissionActivity"
            android:exported="true"
            android:label="@string/permission_label"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Calendar from the phone app (Data Layer item `/calendar`), kept for the face. -->
        <service
            android:name=".PhoneCalendarListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/calendar" />
            </intent-filter>
        </service>

        <!-- Slot `ring`: the whole ring drawn as one image (spike 2, PRD §6.3a risk 9). -->
        <service
            android:name=".RingImageDataSourceService"
            android:exported="true"
            android:label="@string/ring_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Slot `status`: VALUE = selected (0/1) drives the face's Transforms; TEXT = details (slot 4). -->
        <service
            android:name=".StatusDataSourceService"
            android:exported="true"
            android:label="@string/status_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>


        <!-- Slot `details`: the line under the time range. -->
        <service
            android:name=".DetailsDataSourceService"
            android:exported="true"
            android:label="@string/details_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Slot `ring_promote`: the arc settling from the later lane onto the ring (M3). -->
        <service
            android:name=".PromoteDataSourceService"
            android:exported="true"
            android:label="@string/promote_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>


        <!-- Slot `title_scroll`: the full title, scrolled by the face when it doesn't fit (C9a). -->
        <service
            android:name=".TitleScrollDataSourceService"
            android:exported="true"
            android:label="@string/title_scroll_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Slot `title_scroll_arrow`: the full title, scrolled by the face when it doesn't fit (C9a). -->
        <service
            android:name=".TitleScrollArrowDataSourceService"
            android:exported="true"
            android:label="@string/title_scroll_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Invisible tap handler for the face's 12 hour hotspots (PRD §6.3 risk 1). -->
        <activity
            android:name=".TapActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="app"
                    android:host="io.github.karthikeyags07.scheduleclock" />
            </intent-filter>
        </activity>
    </application>
</manifest>
