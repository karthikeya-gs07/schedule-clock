<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Meeting buzzes (RULES §11): exact alarms (allowed for calendar apps), vibration, re-arm after restart. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Watch Face Push (PRD §6.5): install the CalenTime face, and make it the watch face once (asked at runtime). -->
    <uses-permission android:name="com.google.wear.permission.PUSH_WATCH_FACES" />
    <uses-permission android:name="com.google.wear.permission.SET_PUSHED_WATCH_FACE_AS_ACTIVE" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round" android:label="@string/app_name">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Watch Face Push: the default face (amber) sits at assets/default_watchface.apk with its token. -->
        <meta-data
            android:name="com.google.android.wearable.marketplace.DEFAULT_WATCHFACE_VALIDATION_TOKEN"
            android:value="@string/default_wf_token" />

        <!-- Covers the watch while the colourway's face is swapped in, so Wear OS's plain stand-in clock isn't seen. -->
        <activity
            android:name=".ColourSwapActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=".colourswap"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Puts the face on the watch in a colourway and, once, makes it the watch face. -->
        <activity
            android:name=".FaceSetupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Calendar access (READ_CALENDAR): opened by a ring tap while it's missing, or from the app list. -->
        <activity
            android:name=".PermissionActivity"
            android:exported="true"
            android:label="@string/permission_label"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Meeting buzzes: the next buzz's alarm, and re-arming after a restart or a clock change. -->
        <receiver android:name=".BuzzReceiver" android:exported="false" />
        <receiver android:name=".BuzzRearmReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The phone app asks about the face and switches its colourway (Data Layer requests `/face/...`). -->
        <service
            android:name=".FaceRequestService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/face" />
            </intent-filter>
        </service>

        <!-- From the phone app: the calendar (`/calendar`) and its settings (`/settings`: buzzes, colourway). -->
        <service
            android:name=".PhoneCalendarListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/calendar" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/settings" />
            </intent-filter>
        </service>

        <!-- Slot `ring`: the whole ring drawn as one image (spike 2, PRD §6.3a risk 9). -->
        <service
            android:name=".RingImageDataSourceService"
            android:exported="true"
            android:label="@string/ring_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Slot `status`: VALUE = selected (0/1) drives the face's Transforms; TEXT = details (slot 4). -->
        <service
            android:name=".StatusDataSourceService"
            android:exported="true"
            android:label="@string/status_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>


        <!-- Slot `details`: the line under the time range. -->
        <service
            android:name=".DetailsDataSourceService"
            android:exported="true"
            android:label="@string/details_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Slot `ring_promote`: the arc settling from the later lane onto the ring (M3). -->
        <service
            android:name=".PromoteDataSourceService"
            android:exported="true"
            android:label="@string/promote_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>


        <!-- Slot `title_scroll`: the full title, scrolled by the face when it doesn't fit (C9a). -->
        <service
            android:name=".TitleScrollDataSourceService"
            android:exported="true"
            android:label="@string/title_scroll_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Slot `title_scroll_arrow`: the full title, scrolled by the face when it doesn't fit (C9a). -->
        <service
            android:name=".TitleScrollArrowDataSourceService"
            android:exported="true"
            android:label="@string/title_scroll_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Invisible tap handler for the face's 12 hour hotspots (PRD §6.3 risk 1). -->
        <activity
            android:name=".TapActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="app"
                    android:host="io.github.karthikeyags07.scheduleclock" />
            </intent-filter>
        </activity>
    </application>
</manifest>
