<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- New event (RULES A16): lets the app list the calendar apps that can add an event, for the person to pick. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>

    <!-- The app locks to portrait on phones, which makes Play treat a portrait screen as required and hide the app from
         tablets, desktops and XR. It works in any orientation (Android 16 ignores the lock on large screens), so the
         feature is optional. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- Setup, then Today, Calendars, Watchface and Settings (RULES §12). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- Portrait on phones. Android 16 ignores this on large screens (unfolded foldables, tablets), which
                 rotate freely and use the two-pane layout. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: Sync now and when it last synced (RULES A12). -->
        <receiver
            android:name=".SyncWidget"
            android:exported="false"
            android:label="@string/widget_sync">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sync_info" />
        </receiver>
    </application>
</manifest>
